{
  "name": "iw-corretora-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "admin:create": "npm run admin:create -w backend"
  },
  "devDependencies": {"concurrently":"^9.2.1"},
  "engines": {"node": ">=22.12.0"}
}